{
  "name": "opora",
  "productName": "OPORA",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "electron electron/main.cjs",
    "dev:desktop": "concurrently \"npm run dev\" \"npm run electron\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "docx": "^9.8.1",
    "lucide-react": "^1.52.0",
    "motion": "^14.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "ua.opora.app",
    "productName": "OPORA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules"
        ]
      },
      {
        "from": "electron/backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "../dilovod/templates",
        "to": "templates"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
